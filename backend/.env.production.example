# Production environment — NEVER commit real values here
# Copy this file to backend/.env.production and fill in real values on the server
# DO NOT put real credentials in this .example file

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nextlevel?retryWrites=true&w=majority

# JWT — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-random-hex-string>

# Mentor master password
MENTOR_MASTER_PASSWORD=<choose-a-strong-password>

# ── Email delivery ──────────────────────────────────────────
# IMPORTANT: Render BLOCKS outbound SMTP, so Gmail SMTP will NOT send from there.
# Use an HTTPS email API. The app prefers BREVO_API_KEY, then RESEND_API_KEY.
#
# Brevo (free, no domain needed):
#   1. Create an account at https://www.brevo.com → SMTP & API → API Keys → create.
#   2. Senders, Domains & Dedicated IPs → add a sender → verify it via the OTP emailed to you.
#   3. Set EMAIL_FROM to "Name <that-verified-email>". With no verified domain, Brevo
#      re-signs it under its own brevosend.com identity (delivers, but may land in spam).
BREVO_API_KEY=<brevo-api-key>
EMAIL_FROM=NEXT_LEVEL <your-verified-sender@gmail.com>
MENTOR_EMAIL=mentor@example.com

# Resend alternative (HTTPS) — requires a verified DOMAIN to email arbitrary users.
# RESEND_API_KEY=<resend-api-key>
#
# Gmail SMTP — local dev only, or hosts that allow SMTP. Ignored when an API key is set.
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=<gmail-app-password-16-chars>

# Frontend URL
FRONTEND_URL=https://your-app.vercel.app

# CORS — set to "true" only if you deploy frontend previews on *.vercel.app and
# want them allowed to call this API. Leave unset/false for strict allowlist.
# FRONTEND_URL also accepts a comma-separated list of allowed origins.
ALLOW_VERCEL_PREVIEWS=false
