# Production environment — NEVER commit real values here
# Copy this file to backend/.env.production and fill in real values on the server
# DO NOT put real credentials in this .example file

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nextlevel?retryWrites=true&w=majority

# JWT — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-random-hex-string>

# Mentor master password
MENTOR_MASTER_PASSWORD=<choose-a-strong-password>

# ── Email delivery ──────────────────────────────────────────
# IMPORTANT: Render BLOCKS outbound SMTP, so Gmail SMTP will NOT send from there.
# Use an HTTPS sender. The app picks, in order: GMAIL_* → BREVO_API_KEY → RESEND_API_KEY.
#
# Gmail API (free, no domain, no provider activation gate — sends via your own Gmail):
#   1. Google Cloud Console → new project → enable the Gmail API.
#   2. OAuth consent screen → External → add your Gmail as a Test user → set PUBLISH to
#      "In production" (else the refresh token expires every 7 days).
#   3. Credentials → OAuth client ID (Web app) → add redirect https://developers.google.com/oauthplayground
#   4. OAuth Playground → gear → "Use your own OAuth credentials" → authorize scope
#      https://www.googleapis.com/auth/gmail.send → exchange for a REFRESH token.
#   5. Set the three vars below + EMAIL_FROM to that Gmail address.
GMAIL_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=<oauth-client-secret>
GMAIL_REFRESH_TOKEN=<refresh-token>
EMAIL_FROM=NEXT_LEVEL <your-gmail-address@gmail.com>
MENTOR_EMAIL=mentor@example.com

# Brevo alternative (free, no domain) — but new accounts need manual transactional
# activation by Brevo support before sending works.
# BREVO_API_KEY=<brevo-api-key>
#
# Resend alternative (HTTPS) — requires a verified DOMAIN to email arbitrary users.
# RESEND_API_KEY=<resend-api-key>
#
# Gmail SMTP — local dev only, or hosts that allow SMTP. Ignored when an API sender is set.
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=<gmail-app-password-16-chars>

# Frontend URL
FRONTEND_URL=https://your-app.vercel.app

# CORS — set to "true" only if you deploy frontend previews on *.vercel.app and
# want them allowed to call this API. Leave unset/false for strict allowlist.
# FRONTEND_URL also accepts a comma-separated list of allowed origins.
ALLOW_VERCEL_PREVIEWS=false
