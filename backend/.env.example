# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas — create a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nextlevel?retryWrites=true&w=majority

# Optional: if mongodb+srv:// fails with "querySrv ECONNREFUSED" (your network's
# default DNS won't serve SRV records), point Node at a public DNS resolver.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-random-hex-string>

# Mentor master password (used to log in as mentor)
MENTOR_MASTER_PASSWORD=<choose-a-strong-password>

# Gmail — use an App Password (not your real password): https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=<gmail-app-password-16-chars>
MENTOR_EMAIL=mentor@example.com

# Frontend URL (your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# CORS — set to "true" only if you deploy frontend previews on *.vercel.app and
# want them allowed to call this API. Leave unset/false for strict allowlist.
# FRONTEND_URL also accepts a comma-separated list of allowed origins.
ALLOW_VERCEL_PREVIEWS=false

# Web Push (VAPID) — generate a keypair with:
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('PUB',e.getPublicKey().toString('base64url'));console.log('PRIV',e.getPrivateKey().toString('base64url'))"
# (or: npx web-push generate-vapid-keys). Leave unset to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
